{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDevBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::rvt-dev-nix-uploads",
        "arn:aws:s3:::rvt-dev-nix-uploads/*"
      ]
    },
    {
      "Sid": "DenyNonDevBuckets",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::rvt-dev-nix-uploads",
        "arn:aws:s3:::rvt-dev-nix-uploads/*"
      ]
    }
  ]
}
